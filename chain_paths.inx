<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Chain Paths</name>
  <id>com.github.fablabnbg.inskscape-chain-paths</id>

  <param name="epsilon" type="float" min="0.001" max="999.999" precision="3" gui-text="Max. distance to connect">0.01</param>
  <param name="units" type="optiongroup" appearance="minimal" gui-text=" ">
	<option value="mm">mm</option>
	<option value="cm">cm</option>
	<option value="in">in</option>
	<option value="pt">pt</option>
	<option value="px">px</option></param>
  <param name="snap" type="bool" gui-text="Snap connecting ends together">false</param>
  <param name="close" type="bool" gui-text="Close loops (start/end of the same path)">true</param>
  <!-- Keep in sync with chain_paths.py line 19 __version__ = ... -->
  <label name="about_version">


  https://github.com/fablabnbg/inkscape-chain-paths
  Version 0.8</label>

  <effect needs-live-preview="false" >
    <object-type>path</object-type>
    <effects-menu>
      <submenu name="Modify Path"/>
    </effects-menu>
  </effect>
  <script>
      <command location="inx" interpreter="python">chain_paths.py</command>
  </script>
</inkscape-extension>
